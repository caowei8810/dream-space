generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum InspirationCategory {
  PORTRAIT
  PHOTOGRAPHY
  ANIME
  ILLUSTRATION
  DESIGN
}

enum InspirationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InspirationSourceType {
  AI_PUBLIC_GALLERY
  LICENSED
  INTERNAL
}

enum GenerationTaskStatus {
  QUEUED
  GENERATING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELLED
}

enum QuotaLedgerType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
}

enum AdminRole {
  VIEWER
  OPERATOR
  ADMIN
}

enum GenerationRatio {
  SMART      @map("smart")
  RATIO_21_9 @map("21:9")
  RATIO_16_9 @map("16:9")
  RATIO_3_2  @map("3:2")
  RATIO_4_3  @map("4:3")
  RATIO_1_1  @map("1:1")
  RATIO_3_4  @map("3:4")
  RATIO_2_3  @map("2:3")
  RATIO_9_16 @map("9:16")
}

enum GenerationResolution {
  K2 @map("2K")
  K4 @map("4K")
}

model Inspiration {
  id                String                @id @default(cuid())
  slug              String                @unique
  title             String
  prompt            String                @db.Text
  category          InspirationCategory
  imagePath         String
  thumbnailPath     String
  width             Int
  height            Int
  modelName         String
  ratio             String
  resolutionLabel   String
  authorDisplayName String
  sourceType        InspirationSourceType
  sourceName        String
  sourceUrl         String?
  licenseBasis      String
  isAiGenerated     Boolean               @default(true)
  likeCount         Int                   @default(0)
  sortOrder         Int                   @default(0)
  status            InspirationStatus     @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, category, sortOrder])
  @@index([status, publishedAt])
}

model User {
  id                   String                @id @default(cuid())
  phone                String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             UserSession[]
  agreementAcceptances AgreementAcceptance[]
  generationSessions   GenerationSession[]
  generationTasks      GenerationTask[]
  quotaAccount         QuotaAccount?
  quotaLedgerEntries   QuotaLedgerEntry[]
  referenceUploads     ReferenceUpload[]
}

model AdminUser {
  id          String         @id @default(cuid())
  phone       String         @unique
  displayName String
  role        AdminRole      @default(VIEWER)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessions    AdminSession[]

  @@index([active, role])
}

model AdminVerificationCode {
  id         String    @id
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model GenerationSession {
  id        String           @id @default(cuid())
  userId    String
  title     String
  draft     Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     GenerationTask[]

  @@index([userId, updatedAt])
}

model GenerationTask {
  id                 String                @id @default(cuid())
  sessionId          String
  userId             String
  status             GenerationTaskStatus  @default(QUEUED)
  prompt             String                @db.Text
  model              String
  ratio              GenerationRatio
  resolution         GenerationResolution
  imageCount         Int
  referenceImageUrls Json
  unitCost           Int
  totalCost          Int
  idempotencyKey     String
  queueJobId         String?
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  session            GenerationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  results            GenerationResult[]
  events             GenerationTaskEvent[]
  quotaLedgerEntries QuotaLedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@index([userId, status, createdAt])
}

model GenerationResult {
  id                 String         @id @default(cuid())
  taskId             String
  index              Int
  imagePath          String
  objectKey          String?        @unique
  thumbnailObjectKey String?        @unique
  checksumSha256     String?
  width              Int
  height             Int
  mimeType           String
  byteSize           Int
  thumbnailWidth     Int?
  thumbnailHeight    Int?
  thumbnailByteSize  Int?
  isAiGenerated      Boolean        @default(true)
  createdAt          DateTime       @default(now())
  task               GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, index])
  @@index([taskId])
}

model ReferenceUpload {
  id               String   @id @default(cuid())
  userId           String
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  byteSize         Int
  width            Int
  height           Int
  checksumSha256   String
  createdAt        DateTime @default(now())
  deletedAt        DateTime?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GenerationTaskEvent {
  id        BigInt               @id @default(autoincrement())
  taskId    String
  type      String
  status    GenerationTaskStatus
  payload   Json
  createdAt DateTime             @default(now())
  task      GenerationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
}

model QuotaAccount {
  userId    String   @id
  total     Int      @default(100)
  available Int      @default(100)
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuotaLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  taskId         String?
  type           QuotaLedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([taskId])
}

model VerificationCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model UserSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AgreementAcceptance {
  id              String   @id @default(cuid())
  userId          String
  version         String
  termsAccepted   Boolean  @default(false)
  privacyAccepted Boolean  @default(false)
  aiTermsAccepted Boolean  @default(false)
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}
