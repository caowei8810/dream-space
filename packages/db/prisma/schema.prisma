generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum InspirationCategory {
  PORTRAIT
  PHOTOGRAPHY
  ANIME
  ILLUSTRATION
  DESIGN
}

enum InspirationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InspirationSourceType {
  AI_PUBLIC_GALLERY
  LICENSED
  INTERNAL
}

enum GenerationTaskStatus {
  QUEUED
  GENERATING
  REVIEWING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELLED
}

enum QuotaLedgerType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
}

enum QuotaReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum QuotaReconciliationFindingKind {
  MISSING_RESERVE
  MISSING_RELEASE
  MISSING_CONSUME
  SETTLEMENT_AMOUNT_MISMATCH
  TOTAL_DRIFT
  RESERVED_DRIFT
  AVAILABLE_DRIFT
}

enum QuotaReconciliationFindingStatus {
  OPEN
  REPAIRED
  BLOCKED
}

enum AdminUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum AdminPermissionRisk {
  LOW
  MEDIUM
  HIGH
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  BANNED
  DELETED
}

enum PrivacyRequestType {
  DELETE
  EXPORT
}

enum PrivacyRequestStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum RiskRuleMatchType {
  KEYWORD
  REGEX
}

enum RiskRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RiskAction {
  REJECT
  RESTRICT
  BAN
  MANUAL_REVIEW
}

enum RiskHitStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum RiskSubjectType {
  PROMPT
}

enum GenerationRatio {
  SMART      @map("smart")
  RATIO_21_9 @map("21:9")
  RATIO_16_9 @map("16:9")
  RATIO_3_2  @map("3:2")
  RATIO_4_3  @map("4:3")
  RATIO_1_1  @map("1:1")
  RATIO_3_4  @map("3:4")
  RATIO_2_3  @map("2:3")
  RATIO_9_16 @map("9:16")
}

enum GenerationResolution {
  K2 @map("2K")
  K4 @map("4K")
}

enum ProviderStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum ModelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ModelConfigVersionStatus {
  DRAFT
  PUBLISHED
  ROLLED_BACK
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationReviewStatus {
  OPEN
  CLAIMED
  APPROVED
  REJECTED
}

enum ModerationReviewStage {
  INPUT
  OUTPUT
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum BillingRuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BillingPromotionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CashLedgerType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  REFUND
  ADJUSTMENT
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  REFUNDED
}

enum EntitlementLedgerType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  EXPIRE
  REFUND
  ADJUSTMENT
}

enum RefundStatus {
  REQUESTED
  COMPLETED
  FAILED
}

model Inspiration {
  id                String                @id @default(cuid())
  slug              String                @unique
  title             String
  prompt            String                @db.Text
  category          InspirationCategory
  imagePath         String
  thumbnailPath     String
  width             Int
  height            Int
  modelName         String
  ratio             String
  resolutionLabel   String
  authorDisplayName String
  sourceType        InspirationSourceType
  sourceName        String
  sourceUrl         String?
  licenseBasis      String
  isAiGenerated     Boolean               @default(true)
  likeCount         Int                   @default(0)
  sortOrder         Int                   @default(0)
  status            InspirationStatus     @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sourceResultId    String?               @unique
  sourceResult      GenerationResult?     @relation(fields: [sourceResultId], references: [id], onDelete: Restrict)

  @@index([status, category, sortOrder])
  @@index([status, publishedAt])
}

model User {
  id                     String                       @id @default(cuid())
  phone                  String                       @unique
  status                 UserStatus                   @default(ACTIVE)
  statusReason           String?
  statusChangedAt        DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  sessions               UserSession[]
  agreementAcceptances   AgreementAcceptance[]
  generationSessions     GenerationSession[]
  generationTasks        GenerationTask[]
  quotaAccount           QuotaAccount?
  cashAccount            CashAccount?
  quotaLedgerEntries     QuotaLedgerEntry[]
  cashLedgerEntries      CashLedgerEntry[] @relation("CashLedgerOwner")
  reconciliationFindings QuotaReconciliationFinding[]
  referenceUploads       ReferenceUpload[]
  riskHits               RiskHit[]
  appeals                ModerationAppeal[]
  orders                 BillingOrder[]
  entitlements           UserEntitlement[]
  entitlementLedger      EntitlementLedgerEntry[]
  privacyRequests        PrivacyRequest[]

  @@index([status, updatedAt])
  @@index([createdAt])
}

model BillingRule {
  id              String           @id @default(cuid())
  version         Int              @unique
  standardUnitCents Int
  currency        String           @default("CNY")
  status          BillingRuleStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  promotions      BillingPromotion[]

  @@index([status, publishedAt])
}

model BillingPromotion {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  discountBps   Int
  priority      Int                     @default(0)
  stacking      Boolean                 @default(false)
  startsAt      DateTime
  endsAt        DateTime?
  status        BillingPromotionStatus  @default(DRAFT)
  ruleVersion   Int
  rule          BillingRule             @relation(fields: [ruleVersion], references: [version], onDelete: Restrict)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, startsAt, endsAt, priority])
  @@index([ruleVersion])
}

model Plan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String
  status      PlanStatus   @default(DRAFT)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  versions    PlanVersion[]

  @@index([status, sortOrder])
}

model PlanVersion {
  id                  String       @id @default(cuid())
  planId              String
  version             Int
  priceCents          Int
  imageCount          Int
  validDays           Int
  modelAllowlist      Json?
  resolutionAllowlist Json?
  dailyLimit          Int?
  concurrencyLimit    Int?
  createdAt           DateTime     @default(now())
  plan                Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  orders              BillingOrder[]
  entitlements        UserEntitlement[]

  @@unique([planId, version])
  @@index([planId, createdAt])
}

model BillingOrder {
  id                String          @id @default(cuid())
  userId            String
  planVersionId     String
  status            OrderStatus     @default(PENDING)
  amountCents       Int
  refundedCents     Int             @default(0)
  idempotencyKey    String          @unique
  providerOrderId   String?         @unique
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  planVersion       PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  paymentEvents     PaymentEvent[]
  entitlement       UserEntitlement?
  refunds           Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id              String             @id @default(cuid())
  provider        String
  providerEventId String
  orderId         String?
  status          PaymentEventStatus @default(RECEIVED)
  payload         Json
  errorMessage    String?
  createdAt       DateTime           @default(now())
  processedAt     DateTime?
  order           BillingOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([orderId, createdAt])
}

model UserEntitlement {
  id             String                   @id @default(cuid())
  userId         String
  planVersionId  String
  orderId        String?                  @unique
  available      Int
  reserved       Int                    @default(0)
  expiresAt      DateTime
  status         EntitlementStatus       @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  planVersion    PlanVersion            @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  order          BillingOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ledger         EntitlementLedgerEntry[]

  @@index([userId, status, expiresAt])
}

model EntitlementLedgerEntry {
  id             String                @id @default(cuid())
  userId         String
  entitlementId  String
  taskId         String?
  type           EntitlementLedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String                @unique
  metadata       Json?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  entitlement    UserEntitlement      @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  task           GenerationTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entitlementId, createdAt])
  @@index([taskId, type])
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  amountCents    Int
  status         RefundStatus @default(REQUESTED)
  idempotencyKey String       @unique
  reason         String
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  order          BillingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model AdminUser {
  id              String           @id @default(cuid())
  employeeNo      String           @unique
  phone           String           @unique
  displayName     String
  status          AdminUserStatus  @default(INVITED)
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        AdminSession[]
  roles           AdminUserRole[]
  auditEvents     AdminAuditLog[]  @relation("AdminAuditActor")
  claimedReviews  ModerationReview[] @relation("ModerationReviewAssignee")
  decidedAppeals  ModerationAppeal[] @relation("ModerationAppealDecider")
  processedPrivacyRequests PrivacyRequest[] @relation("PrivacyRequestProcessor")

  @@index([status, updatedAt])
  @@index([displayName])
}

model AdminRole {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  description String
  system      Boolean               @default(false)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  users       AdminUserRole[]
  permissions AdminRolePermission[]

  @@index([active, name])
}

model AdminPermission {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  description String
  risk        AdminPermissionRisk   @default(LOW)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       AdminRolePermission[]

  @@index([active, risk])
}

model AdminUserRole {
  adminUserId String
  roleId      String
  assignedAt  DateTime  @default(now())
  assignedBy  String?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([adminUserId, roleId])
  @@index([roleId, adminUserId])
}

model AdminRolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
}

model AdminAuditLog {
  id               String     @id @default(cuid())
  actorAdminUserId String?
  action           String
  resourceType     String
  resourceId       String
  reason           String
  requestId        String
  before           Json?
  after            Json?
  createdAt        DateTime   @default(now())
  actor            AdminUser? @relation("AdminAuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([actorAdminUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([requestId])
}

model RiskRule {
  id         String             @id @default(cuid())
  code       String
  version    Int                @default(1)
  name       String
  matchType  RiskRuleMatchType
  pattern    String             @db.Text
  category   String
  action     RiskAction
  priority   Int                @default(0)
  status     RiskRuleStatus     @default(DRAFT)
  enabled    Boolean            @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  hits       RiskHit[]

  @@unique([code, version])
  @@index([status, enabled, priority])
  @@index([startsAt, endsAt])
}

model RiskHit {
  id          String          @id @default(cuid())
  userId      String
  taskId      String?
  ruleId      String?
  ruleVersion Int?
  subjectType RiskSubjectType
  inputHash   String
  inputLength Int
  action      RiskAction
  status      RiskHitStatus   @default(RESOLVED)
  decision    String
  requestId   String
  metadata    Json?
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  rule        RiskRule?       @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@unique([userId, requestId])
  @@index([status, createdAt])
  @@index([ruleId, createdAt])
  @@index([taskId])
}

model AdminVerificationCode {
  id         String    @id
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model GenerationSession {
  id        String           @id @default(cuid())
  userId    String
  title     String
  draft     Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     GenerationTask[]

  @@index([userId, updatedAt])
}

model GenerationTask {
  id                     String                @id @default(cuid())
  sessionId              String
  userId                 String
  status                 GenerationTaskStatus  @default(QUEUED)
  prompt                 String                @db.Text
  model                  String
  ratio                  GenerationRatio
  resolution             GenerationResolution
  imageCount             Int
  referenceImageUrls     Json
  unitCost               Int
  totalCost              Int
  billingRuleVersion     Int?
  billingPromotionCode   String?
  billingUnitCents       Int?
  billingTotalCents      Int?
  entitlementReserved    Int                 @default(0)
  cashReservedCents      Int                 @default(0)
  modelConfigSnapshot    Json?
  idempotencyKey         String
  queueJobId             String?
  attempts               Int                   @default(0)
  lastAttemptKey         String?
  errorCode              String?
  errorMessage           String?
  inputModerationStatus  ModerationStatus      @default(PENDING)
  outputModerationStatus ModerationStatus      @default(PENDING)
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  session                GenerationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  results                GenerationResult[]
  events                 GenerationTaskEvent[]
  quotaLedgerEntries     QuotaLedgerEntry[]
  cashLedgerEntries      CashLedgerEntry[]
  entitlementLedger     EntitlementLedgerEntry[]
  deadLetter             GenerationDeadLetter?
  riskHits               RiskHit[]
  moderationReviews      ModerationReview[]
  appeals                ModerationAppeal[]
  modelConfigVersion     ModelConfigVersion? @relation(fields: [modelConfigVersionId], references: [id], onDelete: SetNull)
  modelConfigVersionId   String?

  @@unique([userId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@index([userId, status, createdAt])
  @@index([modelConfigVersionId])
}

model Provider {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  status      ProviderStatus @default(DRAFT)
  baseUrl     String?
  secretRef   String?
  timeoutMs   Int            @default(30000)
  retryLimit  Int            @default(2)
  health      String         @default("unknown")
  lastCheckedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      Model[]
  routes      ModelRoute[]
}

model Model {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  providerId     String
  providerModelId String
  status         ModelStatus    @default(DRAFT)
  visible        Boolean        @default(false)
  capabilities   Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  routes         ModelRoute[]
  configVersions ModelConfigVersion[]
  @@index([status, visible])
  @@index([providerId, status])
}

model ModelRoute {
  id          String   @id @default(cuid())
  modelId     String
  providerId  String
  weight      Int      @default(100)
  priority    Int      @default(0)
  enabled     Boolean  @default(false)
  health      String   @default("unknown")
  lastCheckedAt DateTime?
  model       Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([modelId, providerId])
  @@index([enabled, priority])
}

model ModelConfigVersion {
  id          String                    @id @default(cuid())
  modelId     String
  version     Int
  status      ModelConfigVersionStatus  @default(DRAFT)
  config      Json
  reason      String
  publishedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  model       Model                     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  tasks       GenerationTask[]

  @@unique([modelId, version])
  @@index([modelId, status])
}

model GenerationDeadLetter {
  id           String         @id @default(cuid())
  taskId       String         @unique
  errorCode    String
  errorMessage String
  attempts     Int
  payload      Json
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  task         GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

model GenerationResult {
  id                 String           @id @default(cuid())
  taskId             String
  index              Int
  imagePath          String
  objectKey          String?          @unique
  thumbnailObjectKey String?          @unique
  checksumSha256     String?
  width              Int
  height             Int
  mimeType           String
  byteSize           Int
  thumbnailWidth     Int?
  thumbnailHeight    Int?
  thumbnailByteSize  Int?
  moderationStatus   ModerationStatus @default(PENDING)
  isAiGenerated      Boolean          @default(true)
  createdAt          DateTime         @default(now())
  task               GenerationTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  inspiration        Inspiration?
  moderationReviews  ModerationReview[]
  appeals            ModerationAppeal[]

  @@unique([taskId, index])
  @@index([taskId])
}

model ModerationReview {
  id            String                 @id @default(cuid())
  taskId        String?
  resultId      String?
  stage         ModerationReviewStage
  status        ModerationReviewStatus  @default(OPEN)
  reasonCode    String
  reason        String?
  assignedToId  String?
  claimedAt     DateTime?
  decision      String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  task          GenerationTask?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  result        GenerationResult?      @relation(fields: [resultId], references: [id], onDelete: Cascade)
  assignedTo    AdminUser?             @relation("ModerationReviewAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([taskId, stage])
  @@index([resultId, stage])
}

model ModerationAppeal {
  id            String        @id @default(cuid())
  userId        String
  taskId        String?
  resultId      String?
  reason        String        @db.Text
  status        AppealStatus  @default(OPEN)
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          GenerationTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  result        GenerationResult? @relation(fields: [resultId], references: [id], onDelete: Cascade)
  decidedBy     AdminUser?    @relation("ModerationAppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([taskId])
  @@index([resultId])
}

model ReferenceUpload {
  id               String    @id @default(cuid())
  userId           String
  objectKey        String    @unique
  originalFilename String
  mimeType         String
  byteSize         Int
  width            Int
  height           Int
  checksumSha256   String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PrivacyRequest {
  id             String               @id @default(cuid())
  userId         String
  type           PrivacyRequestType
  status         PrivacyRequestStatus  @default(REQUESTED)
  reason         String               @db.Text
  requestedAt    DateTime              @default(now())
  processedAt    DateTime?
  processedById  String?
  decisionNote   String?              @db.Text
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  processedBy    AdminUser?           @relation("PrivacyRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([status, requestedAt])
}

model GenerationTaskEvent {
  id        BigInt               @id @default(autoincrement())
  taskId    String
  type      String
  status    GenerationTaskStatus
  payload   Json
  createdAt DateTime             @default(now())
  task      GenerationTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, id])
}

model QuotaAccount {
  userId                 String                       @id
  total                  Int                          @default(100)
  available              Int                          @default(100)
  reserved               Int                          @default(0)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reconciliationFindings QuotaReconciliationFinding[]
}

model CashAccount {
  userId    String            @id
  available Int               @default(0)
  reserved  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   CashLedgerEntry[] @relation("CashAccountEntries")

  @@index([available, reserved])
}

model CashLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  taskId         String?
  type           CashLedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String          @unique
  metadata       Json?
  createdAt      DateTime        @default(now())
  account        CashAccount     @relation("CashAccountEntries", fields: [userId], references: [userId], onDelete: Cascade, map: "CashLedgerEntry_account_fkey")
  user           User            @relation("CashLedgerOwner", fields: [userId], references: [id], onDelete: Cascade, map: "CashLedgerEntry_user_fkey")
  task           GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([taskId, type])
}

model QuotaLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  taskId         String?
  type           QuotaLedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([taskId])
}

model QuotaReconciliationRun {
  id            String                       @id @default(cuid())
  windowKey     String                       @unique
  status        QuotaReconciliationRunStatus @default(RUNNING)
  startedAt     DateTime                     @default(now())
  completedAt   DateTime?
  scannedUsers  Int                          @default(0)
  scannedTasks  Int                          @default(0)
  mismatchCount Int                          @default(0)
  repairedCount Int                          @default(0)
  errorMessage  String?
  createdAt     DateTime                     @default(now())
  findings      QuotaReconciliationFinding[]

  @@index([createdAt, status])
}

model QuotaReconciliationFinding {
  id             String                           @id @default(cuid())
  runId          String
  userId         String
  taskId         String?
  kind           QuotaReconciliationFindingKind
  status         QuotaReconciliationFindingStatus @default(OPEN)
  idempotencyKey String
  expectedAmount Int?
  actualAmount   Int?
  details        Json
  repairedAt     DateTime?
  createdAt      DateTime                         @default(now())
  run            QuotaReconciliationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  user           User                             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "QuotaReconciliationFinding_userId_fkey")
  quotaAccount   QuotaAccount                     @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "QuotaReconciliationFinding_userId_quotaAccount_fkey")

  @@unique([runId, idempotencyKey])
  @@index([runId, status])
  @@index([userId, createdAt])
  @@index([taskId, kind])
}

model VerificationCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model UserSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AgreementAcceptance {
  id              String   @id @default(cuid())
  userId          String
  version         String
  termsAccepted   Boolean  @default(false)
  privacyAccepted Boolean  @default(false)
  aiTermsAccepted Boolean  @default(false)
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
}
