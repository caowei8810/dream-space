# Local development defaults only. Never put production values here.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
AUTH_CODE_TTL_SECONDS=300
AUTH_SESSION_DAYS=30
DATABASE_URL=postgresql://dreamspace:dreamspace_dev@localhost:5432/dreamspace
REDIS_URL=redis://localhost:6379
EXTERNAL_SERVICES_MODE=mock
LOCAL_STORAGE_DIR=.local/storage
MOCK_GENERATION_DELAY_MS=200
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dreamspace-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
