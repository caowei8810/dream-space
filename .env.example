# Local development defaults only. Never put production values here.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_CODE_TTL_SECONDS=300
AUTH_SESSION_DAYS=30
DATABASE_URL=postgresql://dreamspace:dreamspace_dev@localhost:5432/dreamspace
REDIS_URL=redis://localhost:6379
EXTERNAL_SERVICES_MODE=mock
MODERATION_BASE_URL=
MODERATION_SECRET_REF=
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT_MS=30000
PRIVACY_CLEANUP_ENABLED=false
PRIVACY_CLEANUP_INTERVAL_MS=86400000
PRIVACY_RETENTION_DAYS=30
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-32-character-secret
OBJECT_STORAGE_MODE=local
LOCAL_STORAGE_DIR=../../.local/storage
MOCK_GENERATION_DELAY_MS=200
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dreamspace-local
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
MOCK_ASSET_DIR=../../apps/web/public/inspiration
